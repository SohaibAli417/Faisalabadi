# Copy this file to ".env" (without quotes) and fill in your values.
# The POS loads .env automatically on startup.

# Cloud database (Supabase) - enables automatic sync between the shop laptop
# and the live website. Get these from your Supabase project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# How often the local database syncs to the cloud (milliseconds)
SYNC_INTERVAL_MS=15000

# Port for the local POS server (default 3000)
PORT=3000
